    <!-- Help -->
    <string name="help_drawing_title">Dessin et pinceaux</string>
    <string name="help_drawing_desc">Appuyez à nouveau sur Stylo ou appuyez longuement pour basculer entre Stylo, Pinceau, Feutre, Surligneur et Calligraphie, et choisir des couleurs ou des tailles.</string>
    <string name="help_zoom_title">Zone infinie et zoom</string>
    <string name="help_zoom_desc" formatted="false">Pinch with two fingers to zoom (25%–500%) and drag with two fingers to pan in any tool, or select Hand mode for one-finger panning.</string>
    <string name="help_shapes_title">Formes et sélection</string>
    <string name="help_shapes_desc">Choisissez parmi 45 formes. Après avoir dessiné, faites glisser les poignées pour déplacer, redimensionner ou faire pivoter. Utilisez le Lasso pour sélectionner et copier, retourner, recolorer ou supprimer des objets.</string>
    <string name="help_layers_title">Calques et multipages</string>
    <string name="help_layers_desc">Appuyez sur le sélecteur de page (1/1) pour gérer les pages, et sur Calques pour ajouter, masquer, verrouiller ou réorganiser jusqu\'à 10 calques indépendamment de l\'arrière-plan.</string>
    <string name="help_pdf_title">Importer et exporter des PDF</string>
    <string name="help_pdf_desc">Importez n\'importe quel PDF pour l\'annoter page par page sans surcharger la mémoire, surlignez le texte clairement et exportez tout votre tableau au format PDF.</string>
    <string name="help_stylus_title">Stylet et S-Pen</string>
    <string name="help_stylus_desc">La pression du stylet ajuste automatiquement l\'épaisseur du trait. Activez \"Stylet uniquement\" dans les Paramètres pour le rejet de la paume, et utilisez le bouton du stylet pour effacer.</string>
    <string name="help_ai_title">Écriture intelligente et OCR sur l\'appareil</string>
    <string name="help_ai_desc">Écrivez en mode Intelligent et marquez une pause d\'une seconde pour convertir votre écriture en texte typographié. Utilisez l\'OCR pour numériser des photos hors ligne avec un historique complet, gratuitement et sans limite.</string>
    <string name="help_classroom_title">Formule, tableau, géométrie et enregistreur</string>
    <string name="help_classroom_desc">Insérez des formules LaTeX, des tableaux modifiables, des diagrammes scientifiques vectoriels, des règles/rapporteurs/compas interactifs, une calculatrice, un minuteur, une vidéo flottante et l\'enregistrement d\'écran illimité avec Face Cam.</string>
    <string name="help_contact">Contacter l\'assistance</string>
