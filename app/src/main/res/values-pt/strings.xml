    <!-- Help -->
    <string name="help_drawing_title">Desenho e pincéis</string>
    <string name="help_drawing_desc">Toque na Caneta novamente ou pressione e segure para alternar entre Caneta, Pincel, Marcador, Marca-texto e Caligrafia, e escolher cores ou tamanhos.</string>
    <string name="help_zoom_title">Tela infinita e zoom</string>
    <string name="help_zoom_desc" formatted="false">Pinch with two fingers to zoom (25%–500%) and drag with two fingers to pan in any tool, or select Hand mode for one-finger panning.</string>
    <string name="help_shapes_title">Formas e seleção</string>
    <string name="help_shapes_desc">Escolha entre 45 formas. Após desenhar, arraste as alças para mover, redimensionar ou girar. Use o Laço para selecionar e copiar, inverter, mudar a cor ou excluir objetos.</string>
    <string name="help_layers_title">Camadas e várias páginas</string>
    <string name="help_layers_desc">Toque no indicador de página (1/1) para gerenciar páginas e em Camadas para adicionar, ocultar, bloquear ou reordenar até 10 camadas de forma independente do fundo.</string>
    <string name="help_pdf_title">Importar e exportar PDF</string>
    <string name="help_pdf_desc">Importe qualquer PDF para anotar página por página sem consumo excessivo de memória, destaque textos com clareza e exporte todo o quadro como PDF.</string>
    <string name="help_stylus_title">Caneta Stylus e S-Pen</string>
    <string name="help_stylus_desc">A pressão da caneta ajusta automaticamente a espessura do traço. Ative \"Desenhar apenas com caneta\" nas Configurações para rejeição da palma e use o botão da caneta para apagar.</string>
    <string name="help_ai_title">Escrita inteligente e OCR no dispositivo</string>
    <string name="help_ai_desc">Escreva no modo Inteligente e pause 1 segundo para converter a caligrafia em texto digitado. Use o OCR para digitalizar fotos offline com histórico completo de digitalizações — totalmente gratuito e ilimitado.</string>
    <string name="help_classroom_title">Fórmula, tabela, geometria e gravador</string>
    <string name="help_classroom_desc">Insira fórmulas LaTeX, tabelas editáveis, diagramas científicos vetoriais, réguas/transferidores/compassos interativos, calculadora, temporizador, vídeo flutuante e gravação de tela ilimitada com Face Cam opcional.</string>
    <string name="help_contact">Entrar em contato com o suporte</string>
