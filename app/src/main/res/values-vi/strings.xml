    <string name="help_brushes_desc">Nhấn vào Bút lần nữa để mở Tùy chọn cọ (Bút, Cọ, Bút lông, Dạ quang, Thư pháp). Tẩy nét mực chỉ xóa nét vẽ và không ảnh hưởng đến hình nền bảng hay tệp PDF.</string>
    <string name="help_smart_shapes_title">Hình dạng thông minh (15 dạng hình)</string>
    <string name="help_smart_shapes_desc">Bật Hình dạng thông minh trong bảng Cọ vẽ để tự động nhận dạng Đường thẳng, Hình tròn, Hình bầu dục, Tam giác, Vuông, Chữ nhật, Hình thoi, Ngũ giác và Lục giác.</string>
    <string name="help_smart_writing_title">Viết thông minh (18 ngôn ngữ)</string>
    <string name="help_smart_writing_desc">Chọn chế độ Thông minh, chọn ngôn ngữ của bạn, viết tự nhiên và tạm dừng 1,5 giây để chuyển chữ viết tay thành văn bản sắc nét.</string>
    <string name="help_ocr_title">Máy quét OCR trên thiết bị</string>
    <string name="help_ocr_desc">Chụp ảnh hoặc chọn từ bộ sưu tập, cắt vùng văn bản và trích xuất văn bản ngoại tuyến qua các hệ chữ Latin, Devanagari, Trung, Nhật và Hàn.</string>
    <string name="help_recording_title">Ghi màn hình không giới hạn &amp; Camera khuôn mặt</string>
    <string name="help_recording_desc">Ghi lại bài học video MP4 độ phân giải 480p, 720p hoặc 1080p với âm thanh micrô và bóng Camera khuôn mặt có thể kéo thả tùy chọn — không có watermark và không giới hạn thời gian.</string>
    <string name="help_backup_title">Sao lưu &amp; Khôi phục Zip</string>
    <string name="help_backup_desc">Mở Cài đặt để xuất tất cả các bảng, hình ảnh, tệp PDF và hình thu nhỏ của bạn vào một tệp lưu trữ .zip di động và khôi phục chúng bất kỳ lúc nào.</string>
