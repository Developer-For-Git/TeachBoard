    <string name="help_smart_writing_title">Smart Writing (18 Languages)</string>
    <string name="help_smart_writing_desc">Select Smart mode, pick your language, write naturally, and pause 1.5 seconds to turn handwriting into crisp text.</string>
    <string name="help_ocr_title">On-Device OCR Scanner</string>
    <string name="help_ocr_desc">Capture a photo or choose from gallery, crop to the text area, and extract text offline across Latin, Devanagari, Chinese, Japanese, and Korean scripts.</string>
    <string name="help_recording_title">Unlimited Screen Recorder &amp; Face Cam</string>
    <string name="help_recording_desc">Record 480p, 720p, or 1080p MP4 lessons with microphone audio and an optional draggable Face Cam bubble—no watermarks and no time limit.</string>
    <string name="help_backup_title">Zip Backup &amp; Restore</string>
    <string name="help_backup_desc">Open Settings to export all your boards, images, PDFs, and thumbnails into a portable .zip archive and restore them anytime.</string>
