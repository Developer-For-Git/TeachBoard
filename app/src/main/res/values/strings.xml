    <!-- Help -->
    <string name="help_drawing_title">Drawing &amp; Brushes</string>
    <string name="help_drawing_desc">Tap Pen again or long-press to switch between Pen, Brush, Marker, Highlight, and Calligraphy, and pick colors or sizes.</string>
    <string name="help_zoom_title">Infinite Canvas &amp; Zoom</string>
    <string name="help_zoom_desc" formatted="false">Pinch with two fingers to zoom (25%–500%) and drag with two fingers to pan in any tool, or select Hand mode for one-finger panning.</string>
    <string name="help_shapes_title">Shapes &amp; Selection</string>
    <string name="help_shapes_desc">Choose from 45 shapes. After drawing, drag handles to move, resize, or rotate. Use Lasso to select and copy, flip, recolor, or delete objects.</string>
    <string name="help_layers_title">Layers &amp; Multi-Page</string>
    <string name="help_layers_desc">Tap the page chip (1/1) to manage pages, and tap Layers to add, hide, lock, or reorder up to 10 layers independently of the background.</string>
    <string name="help_pdf_title">Import &amp; Export PDF</string>
    <string name="help_pdf_desc">Import any PDF to annotate page-by-page without heavy memory use, highlight text clearly, and export your entire board as a PDF.</string>
    <string name="help_stylus_title">Stylus &amp; S-Pen</string>
    <string name="help_stylus_desc">Stylus pressure automatically adjusts stroke width. Enable \"Only pen draws\" in Settings for palm rejection, and use the stylus button to erase.</string>
    <string name="help_ai_title">Smart Handwriting &amp; On-Device OCR</string>
    <string name="help_ai_desc">Write in Smart mode and pause 1 second to convert handwriting into typed text. Use OCR to scan photos offline with full scan history — completely free with no limits.</string>
    <string name="help_classroom_title">Formula, Table, Geometry &amp; Recorder</string>
    <string name="help_classroom_desc">Insert LaTeX formulas, editable tables, vector science diagrams, ruler/protractor/compass overlays, calculator, timer, floating video, and unlimited screen recording with optional Face Cam.</string>
    <string name="help_contact">Contact support</string>

